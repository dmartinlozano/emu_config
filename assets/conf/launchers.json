      "players": [
        {
          "name": "PPSSPP",
          "package": "org.ppsspp.ppsspp",
          "amStartArguments": "-n org.ppsspp.ppsspp/org.ppsspp.ppsspp.PpssppActivity\n-d {file.uri}",
          "killPackageProcesses": false
